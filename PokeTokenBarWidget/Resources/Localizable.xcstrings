  "strings": {
    "+%lld more in app": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱에서 %lld개 더"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリでさらに%lld件"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "+%lld más en la app"
          }
        }
      }
    },
    "No companion": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "컴패니언 없음"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コンパニオンなし"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin compañero"
          }
        }
      }
    },
    "No rate limits active": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "활성화된 한도가 없어요"
