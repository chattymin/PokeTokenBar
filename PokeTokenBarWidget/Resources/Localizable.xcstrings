        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効な上限はありません"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay límites activos"
          }
        }
      }
    },
    "Open the app to sync from your Mac": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
