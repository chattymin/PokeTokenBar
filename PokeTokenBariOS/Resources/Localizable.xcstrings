    "Data syncs automatically via iCloud when both devices share the same Apple ID.\n\nFor local network sync, enter your Mac's IP address below.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두 기기가 같은 Apple ID를 쓰면 iCloud로 자동 동기화돼요.\n\n로컬 네트워크 동기화를 쓰려면 아래에 Mac의 IP 주소를 입력하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "両方のデバイスが同じApple IDなら、iCloud経由で自動同期されます。\n\nローカルネットワーク同期を使う場合は、下にMacのIPアドレスを入力してください。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los datos se sincronizan automáticamente por iCloud cuando ambos dispositivos usan el mismo Apple ID.\n\nPara sincronizar por red local, introduce abajo la IP de tu Mac."
          }
        }
      }
    },
    "Data syncs via iCloud. Local network is used as fallback when iCloud is unavailable.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "데이터는 iCloud로 동기화돼요. iCloud를 쓸 수 없을 때 로컬 네트워크를 대신 사용해요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "データはiCloud経由で同期されます。iCloudが使えないときはローカルネットワークを使います。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los datos se sincronizan por iCloud. La red local se usa como alternativa cuando iCloud no está disponible."
          }
        }
      }
    },
    "Find your Mac's IP in System Settings → Network, or enable the iPhone companion server in PokeTokenBar settings.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac의 IP는 시스템 설정 → 네트워크에서 확인하거나, PokeTokenBar 설정에서 iPhone 컴패니언 서버를 켜세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "MacのIPはシステム設定 → ネットワークで確認するか、PokeTokenBarの設定でiPhoneコンパニオンサーバーを有効にしてください。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Encuentra la IP de tu Mac en Ajustes del Sistema → Red, o activa el servidor para iPhone en los ajustes de PokeTokenBar."
          }
        }
      }
    },
